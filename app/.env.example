# 应用监听
VITE_APP_HOST=0.0.0.0
VITE_APP_PORT=3000

# 项目名称
VITE_APP_TITLE=Blog Admin

# 代理前缀
VITE_APP_BASE_API=/dev-api

# 接口地址
VITE_APP_API_PROTOCOL=http
VITE_APP_API_HOST=127.0.0.1
VITE_APP_API_PORT=3925
VITE_APP_API_PREFIX=/api
VITE_APP_API_URL=${VITE_APP_API_PROTOCOL}://${VITE_APP_API_HOST}:${VITE_APP_API_PORT}${VITE_APP_API_PREFIX}

# 启用 Mock 服务(true:开启 false:关闭)
VITE_MOCK_DEV_SERVER=false

# 多租户开关(true:开启 false:关闭)
VITE_APP_TENANT_ENABLED=false
