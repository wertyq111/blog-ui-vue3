{
  "name": "blog-ui-vue3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean:appledouble": "(find ./src -name '._*' -exec rm -f {} + 2>/dev/null || true) && (find . -maxdepth 1 -name '._*' -exec rm -f {} + 2>/dev/null || true)",
    "dev": "vite",
    "build": "npm run clean:appledouble && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run clean:appledouble && vue-tsc --noEmit",
    "lint": "npm run clean:appledouble && eslint . --ext .ts,.vue --max-warnings=0",
    "test": "npm run clean:appledouble && vitest",
    "test:run": "npm run clean:appledouble && vitest run --coverage"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.8.4",
    "element-plus": "^2.9.7",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.1.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "vitest": "^3.1.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.8"
  }
}
